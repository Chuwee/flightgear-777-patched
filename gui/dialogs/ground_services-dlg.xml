<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

    <name>ground_services</name>
    <layout>vbox</layout>

    <text>
        <label>Ground Services Controls</label>
    </text>

    <hrule />
    
    <text>
        <label>External Power</label>
    </text>
     
    <group>
    <layout>table</layout>
        <checkbox>
            <row>0</row>
            <col>0</col>
            <label>External Power Cart</label>
            <halign>left</halign>
            <property>services/ext-pwr/enable</property>
            <binding>
                <command>dialog-apply</command>
            </binding>
            <live>true</live>
        </checkbox>
    
        <checkbox>
            <row>1</row>
            <col>0</col>
            <label>Primary Ext. Power</label>
            <halign>left</halign>
            <property>services/ext-pwr/primary</property>
            <binding>
                <command>dialog-apply</command>
            </binding>
            <live>true</live>
        </checkbox>
        
        <checkbox>
            <row>2</row>
            <col>0</col>
            <label>Secondary Ext. Power</label>
            <halign>left</halign>
            <property>services/ext-pwr/secondary</property>
            <binding>
                <command>dialog-apply</command>
            </binding>
            <live>true</live>
        </checkbox>
        
        <checkbox>
            <row>0</row>
            <col>1</col>
            <label>Air Start Unit</label>
            <halign>left</halign>
            <property>services/ASU/enable</property>
            <binding>
                <command>dialog-apply</command>
            </binding>
            <live>true</live>
        </checkbox>
    
        <checkbox>
            <row>1</row>
            <col>1</col>
            <label>Hose 1</label>
            <halign>left</halign>
            <property>services/ASU/hose1-enable</property>
            <binding>
                <command>dialog-apply</command>
            </binding>
            <live>true</live>
        </checkbox>
        
        <checkbox>
            <row>2</row>
            <col>1</col>
            <label>Hose 2</label>
            <halign>left</halign>
            <property>services/ASU/hose2-enable</property>
            <binding>
                <command>dialog-apply</command>
            </binding>
            <live>true</live>
        </checkbox>

    </group>
    
    <hrule />
    
    <text>
        <label>Landing Gear Chocks</label>
    </text>
    
    <group>
    <layout>table</layout>
    
    <text>
        <row>0</row>
        <col>0</col>
        <label>Left Gear</label>
    </text>
    
    <text>
        <row>0</row>
        <col>1</col>
        <label>Nose Gear</label>
    </text>
    
    <text>
        <row>0</row>
        <col>2</col>
        <label>Right Gear</label>
    </text>
    
    <checkbox>
        <row>1</row>
        <col>0</col>
        <property>services/chocks/left</property>
        <binding>
            <command>dialog-apply</command>
        </binding>
        <live>true</live>
    </checkbox>
    
    <checkbox>
        <row>1</row>
        <col>1</col>
        <property>services/chocks/nose</property>
        <binding>
            <command>dialog-apply</command>
        </binding>
        <live>true</live>
    </checkbox>
    
    <checkbox>
        <row>1</row>
        <col>2</col>
        <property>services/chocks/right</property>
        <binding>
            <command>dialog-apply</command>
        </binding>
        <live>true</live>
    </checkbox>
    
    <button>
        <row>2</row>
        <col>1</col>
        <halign>center</halign>
        <legend>Toggle chocks</legend>
        <pref-width>110</pref-width>
        <pref-height>20</pref-height>
        <binding>
            <command>property-toggle</command>
            <property>services/chocks/left</property>
        </binding>
        <binding>
            <command>property-toggle</command>
            <property>services/chocks/nose</property>
        </binding>
        <binding>
            <command>property-toggle</command>
            <property>services/chocks/right</property>
        </binding>
    </button>
    
    </group>

    <hrule />
    
    <text>
        <label>Safety Cones</label>
    </text>
    
    <group>
        <layout>table</layout>
        
		<checkbox>
			<row>0</row>
			<col>0</col>
			<halign>left</halign>
			<label>Left wingtip Safety Cone</label>
			<property>services/cones/coneLW-enable</property>
			<binding>
				<command>dialog-apply</command>
			</binding>
			<live>true</live>
        </checkbox>
		
		<checkbox>
			<row>0</row>
			<col>1</col>
			<halign>left</halign>
			<label>Right wingtip Safety Cone</label>
			<property>services/cones/coneRW-enable</property>
			<binding>
				<command>dialog-apply</command>
			</binding>
			<live>true</live>
        </checkbox>
		
		<checkbox>
			<row>1</row>
			<col>0</col>
			<halign>left</halign>
			<label>Left Engine Safety Cones</label>
			<property>services/cones/cone1-enable</property>
			<binding>
				<command>dialog-apply</command>
			</binding>
			<live>true</live>
        </checkbox>
        
        <checkbox>
			<row>1</row>
			<col>1</col>
			<halign>left</halign>
			<label>Right Engine Safety Cones</label>
			<property>services/cones/cone2-enable</property>
			<binding>
				<command>dialog-apply</command>
			</binding>
			<live>true</live>
        </checkbox>
		
		<checkbox>
			<row>2</row>
			<col>0</col>
			<halign>left</halign>
			<label>Left Tail Safety Cone</label>
			<property>services/cones/coneTailL-enable</property>
			<binding>
				<command>dialog-apply</command>
			</binding>
			<live>true</live>
        </checkbox>
		
		<checkbox>
			<row>2</row>
			<col>1</col>
			<halign>left</halign>
			<label>Right Tail Safety Cone</label>
			<property>services/cones/coneTailR-enable</property>
			<binding>
				<command>dialog-apply</command>
			</binding>
			<live>true</live>
        </checkbox>

    </group>
    
    <button>
        <halign>center</halign>
        <legend>Toggle cones</legend>
        <pref-width>110</pref-width>
        <pref-height>20</pref-height>
        <binding>
            <command>property-toggle</command>
            <property>services/cones/cone1-enable</property>
        </binding>
        <binding>
            <command>property-toggle</command>
            <property>services/cones/cone2-enable</property>
        </binding>
		<binding>
            <command>property-toggle</command>
            <property>services/cones/coneLW-enable</property>
        </binding>
        <binding>
            <command>property-toggle</command>
            <property>services/cones/coneRW-enable</property>
        </binding>
		<binding>
            <command>property-toggle</command>
            <property>services/cones/coneTailL-enable</property>
        </binding>
        <binding>
            <command>property-toggle</command>
            <property>services/cones/coneTailR-enable</property>
        </binding>
    </button>
    
    <hrule />
    
    <text>
        <label>Passenger Services</label>
    </text>
    
    <group>
    <layout>hbox</layout>
        <checkbox>
        <label>Front Bus</label>
        <property>services/bus/bus1-enable</property>
        <binding>
            <command>dialog-apply</command>
        </binding>
        <live>true</live>
        </checkbox>
        
        <checkbox>
        <label>Rear Bus</label>
        <property>services/bus/bus2-enable</property>
        <binding>
            <command>dialog-apply</command>
        </binding>
        <live>true</live>
        </checkbox>
    </group>

    <hrule />
    
    <text>
        <label>De-icing Truck</label>
    </text>
    
    <group>
    <layout>hbox</layout>

    <checkbox>
        <label>Enable De-icing Trucks</label>
        <property>services/deicing_truck/enable</property>
        <binding>
            <command>dialog-apply</command>
        </binding>
        <binding>
            <command>nasal</command>
            <script>
                if(getprop("services/deicing_truck/enable") == 1) {
                    screen.log.write("De-Icing vehicles ready. Confirm brakes set and treatment required.", 0.5, 0.9, 1.0);
                } else {
                    screen.log.write("Post de-icing check completed, personnel and equipment clear of aircraft.", 0.5, 0.9, 1.0);
                }
            </script>
        </binding>
        <live>true</live>
    </checkbox>

    <button>
        <legend>De-ice Aircraft</legend>
        <padding>5</padding>
        <binding>
            <command>nasal</command>
            <script>
                if ((getprop("controls/gear/brake-parking") != 1) or (getprop("controls/engines/engine[0]/throttle-lever") != 0) or (getprop("controls/engines/engine[1]/throttle-lever") != 0)) {
                    screen.log.write("Please reduce the engines to idle thrust and set the parking brake before commencing the de-icing process.", 1, 0, 0);
                } elsif (getprop("services/deicing_truck/enable") == 1) {
                    setprop("services/deicing_truck/de-ice", 1);
                    screen.log.write("De-icing starts now", 0.5, 0.9, 1);
                } else {
                    screen.log.write("Please Enable the De-icing truck first", 1, 0, 0);
                }
            </script>
        </binding>
    </button>
    </group>
    
    <hrule />
	<group>
		<layout>table</layout>
		<text>
			<label>Hydraulic reservoirs</label>
			<row>0</row>
			<col>0</col>
			<colspan>3</colspan>
			<pref-width>110</pref-width>
			<halign>center</halign>
		</text>
		<text>
			<row>1</row>
			<col>0</col>
			<pref-width>110</pref-width>
			<label>Reservoir</label>
			<halign>right</halign>
			<padding>3</padding>
		</text>
		<text>
			<row>1</row>
			<col>1</col>
			<pref-width>110</pref-width>
			<label>Level</label>
			<halign>right</halign>
			<padding>3</padding>
		</text>
		<text>
			<row>1</row>
			<col>2</col>
			<pref-width>110</pref-width>
			<label>Capacity</label>
			<halign>right</halign>
			<padding>3</padding>
		</text>
		<text>
			<row>2</row>
			<col>0</col>
			<pref-width>110</pref-width>
			<label>Left</label>
			<halign>right</halign>
			<padding>3</padding>
		</text>
		<text>
			<row>2</row>
			<col>1</col>
			<pref-width>110</pref-width>
			<property>consumables/hydraulics/reservoir[0]/level-gal-cmd</property>
			<live>true</live>
			<halign>right</halign>
			<padding>3</padding>
			<format>%.2f gal</format>
		</text>
		<text>
			<row>2</row>
			<col>2</col>
			<pref-width>110</pref-width>
			<property>consumables/hydraulics/reservoir[0]/capacity-gal</property>
			<live>true</live>
			<halign>right</halign>
			<padding>3</padding>
			<format>%.2f gal</format>
		</text>
		<text>
			<row>3</row>
			<col>0</col>
			<pref-width>110</pref-width>
			<label>Center</label>
			<halign>right</halign>
			<padding>3</padding>
		</text>
		<text>
			<row>3</row>
			<col>1</col>
			<pref-width>110</pref-width>
			<property>consumables/hydraulics/reservoir[1]/level-gal-cmd</property>
			<live>true</live>
			<halign>right</halign>
			<padding>3</padding>
			<format>%.2f gal</format>
		</text>
		<text>
			<row>3</row>
			<col>2</col>
			<pref-width>110</pref-width>
			<property>consumables/hydraulics/reservoir[1]/capacity-gal</property>
			<live>true</live>
			<halign>right</halign>
			<padding>3</padding>
			<format>%.2f gal</format>
		</text>
		<text>
			<row>4</row>
			<col>0</col>
			<pref-width>110</pref-width>
			<label>Right</label>
			<halign>right</halign>
			<padding>3</padding>
		</text>
		<text>
			<row>4</row>
			<col>1</col>
			<pref-width>110</pref-width>
			<property>consumables/hydraulics/reservoir[2]/level-gal-cmd</property>
			<live>true</live>
			<halign>right</halign>
			<padding>3</padding>
			<format>%.2f gal</format>
		</text>
		<text>
			<row>4</row>
			<col>2</col>
			<pref-width>110</pref-width>
			<property>consumables/hydraulics/reservoir[2]/capacity-gal</property>
			<live>true</live>
			<halign>right</halign>
			<padding>3</padding>
			<format>%.2f gal</format>
		</text>
		<button>
			<legend>Replenish hydraulic fluid</legend>
			<row>5</row>
			<col>0</col>
			<colspan>3</colspan>
			<halign>center</halign>
			<padding>5</padding>
			<enable>
				<property>aircraft/settings/hydr_consumption</property>
			</enable>
			<binding>
				<condition>
					<property>gear/gear[0]/wow</property>
				</condition>
				<command>property-assign</command>
				<property>consumables/hydraulics/reservoir[0]/level-gal</property>
				<property>consumables/hydraulics/reservoir[0]/capacity-gal</property>
			</binding>
			<binding>
				<condition>
					<property>gear/gear[0]/wow</property>
				</condition>
				<command>property-assign</command>
				<property>consumables/hydraulics/reservoir[1]/level-gal</property>
				<property>consumables/hydraulics/reservoir[1]/capacity-gal</property>
			</binding>
			<binding>
				<condition>
					<property>gear/gear[0]/wow</property>
				</condition>
				<command>property-assign</command>
				<property>consumables/hydraulics/reservoir[2]/level-gal</property>
				<property>consumables/hydraulics/reservoir[2]/capacity-gal</property>
			</binding>
			<binding>
				<condition>
					<not><property>gear/gear[0]/wow</property></not>
				</condition>
				<command>nasal</command>
				<script>
				<![CDATA[
					screen.log.write("Captain, the hydraulic fluid cannot be replenished now, as we are in the air.", 1, 0, 0);
				]]>				
				</script>
			</binding>
		</button>
    
	</group>
	
	<hrule />
	
    <group>
    <layout>hbox</layout>

        <button>
            <legend>Close</legend>
            <default>true</default>
            <key>Esc</key>
        <padding>5</padding>
            <binding>
                <command>dialog-apply</command>
            </binding>
            <binding>
                <command>dialog-close</command>
            </binding>
        </button>
        
    </group>

</PropertyList>
