<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

    <name>aircraft_settings</name>
    <layout>vbox</layout>

    <group>
    <layout>hbox</layout>
        <text>
            <label>Aircraft settings</label>
        </text>
        
        <empty>
            <stretch>true</stretch>
        </empty>
        
        <button>
            <halign>right</halign>
            <pref-width>16</pref-width>
            <pref-height>16</pref-height>
            <legend/>
            <key>Esc</key>
            <binding>
                <command>dialog-close</command>
            </binding>
        </button>
        
    </group>

    <hrule />
    
    <checkbox>
        <label>Show tooltips</label>
        <halign>left</halign>
        <property>aircraft/settings/tooltips</property>
        <binding>
            <command>dialog-apply</command>
        </binding>
        <live>true</live>
    </checkbox>

    <checkbox>
        <label>Store fuel and hydraulic fluid level between sessions</label>
        <halign>left</halign>
        <property>aircraft/settings/fuel_persistent</property>
        <binding>
            <command>dialog-apply</command>
        </binding>
        <live>true</live>
    </checkbox>
	
	<checkbox>
		<label>Allow hydraulic fluid consumption over time</label>
        <halign>left</halign>
		<enable>
			<property>aircraft/settings/fuel_persistent</property>
		</enable>
        <property>aircraft/settings/hydr_consumption</property>
        <binding>
            <command>dialog-apply</command>
        </binding>
        <live>true</live>
    </checkbox>
    
    <checkbox>
        <label>Store pax and cargo between sessions</label>
        <halign>left</halign>
        <property>aircraft/settings/weight_persistent</property>
        <binding>
            <command>dialog-apply</command>
        </binding>
        <live>true</live>
    </checkbox>
    
    <checkbox>
        <label>Store Ground Services between sessions</label>
        <halign>left</halign>
        <property>aircraft/settings/ground_services_persistent</property>
        <binding>
            <command>dialog-apply</command>
        </binding>
        <live>true</live>
    </checkbox>
    
    <checkbox>
        <label>Autodisconnect ground services when task complete</label>
        <halign>left</halign>
        <property>aircraft/settings/gnd_autodisconnect</property>
        <binding>
            <command>dialog-apply</command>
        </binding>
        <live>true</live>
    </checkbox>
    
    <checkbox>
        <label>Autoconnect ground services when on blocks</label>
        <halign>left</halign>
        <property>aircraft/settings/gnd_autoconnect</property>
        <binding>
            <command>dialog-apply</command>
        </binding>
        <live>true</live>
    </checkbox>
    
    <checkbox>
        <label>Connect 3D Jetways if available (weight dialog, autoconnect)</label>
        <halign>left</halign>
        <property>aircraft/settings/gnd_autojetways</property>
        <binding>
            <command>dialog-apply</command>
        </binding>
        <live>true</live>
    </checkbox>
    
    <checkbox>
        <label>Store radio frequencies between sessions</label>
        <halign>left</halign>
        <property>aircraft/settings/radio_persistent</property>
        <binding>
            <command>dialog-apply</command>
        </binding>
        <live>true</live>
    </checkbox>
    
    <group>
    <layout>hbox</layout>

        <button>
            <legend>Close</legend>
            <default>true</default>
            <key>Esc</key>
        <padding>5</padding>
            <binding>
                <command>dialog-apply</command>
            </binding>
            <binding>
                <command>dialog-close</command>
            </binding>
        </button>
        
    </group>

</PropertyList>
