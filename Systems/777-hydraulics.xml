					<property>systems/hydraulics/system[1]/m-pump[3]/press-psi</property>
				</sum>
			</expression>
		</input>
		<input>
			<value>0.0</value>
		</input>
		<output>systems/hydraulics/system[1]/TotalPumpPress-C2-psi</output>
	</filter>
	
	<filter>
		<name>Center System Fltctrl Combined Pump Pressure</name>
		<type>gain</type>
		<gain>1.0</gain>
		<update-interval-secs>0.2</update-interval-secs>
		<input>
			<condition>
				<equals>
					<property>systems/hydraulics/system[1]/IslnValve[1]/opened</property>
					<value>1.0</value>
				</equals>
			</condition>
			<expression>
				<sum>
					<property>systems/hydraulics/system[1]/m-pump[0]/press-psi</property>
					<property>systems/hydraulics/system[1]/m-pump[1]/press-psi</property>
					<property>systems/hydraulics/system[1]/m-pump[2]/press-psi</property>
					<property>systems/hydraulics/system[1]/m-pump[3]/press-psi</property>
					<property>systems/hydraulics/system[1]/m-pump[4]/press-psi</property>
				</sum>
			</expression>
		</input>
		<input>
			<condition>
				<not-equals>
					<property>systems/hydraulics/system[1]/IslnValve[1]/opened</property>
					<value>1.0</value>
				</not-equals>
			</condition>
			<expression>
				<sum>
					<property>systems/hydraulics/system[1]/m-pump[1]/press-psi</property>
					<property>systems/hydraulics/system[1]/m-pump[2]/press-psi</property>
					<property>systems/hydraulics/system[1]/m-pump[3]/press-psi</property>
					<property>systems/hydraulics/system[1]/m-pump[4]/press-psi</property>
				</sum>
			</expression>
		</input>
		<input>
			<value>0.0</value>
		</input>
		<output>systems/hydraulics/system[1]/TotalPumpPress-Fltctrl-psi</output>
	</filter>
	
	<filter>
		<name>Center System C1C2 Combined Pump Pressure</name>
		<type>gain</type>
		<gain>1.0</gain>
		<update-interval-secs>0.2</update-interval-secs>
		<input>
			<condition>
				<equals>
					<property>systems/hydraulics/system[1]/IslnValve[1]/opened</property>
					<value>1.0</value>
				</equals>
			</condition>
			<expression>
				<sum>
					<property>systems/hydraulics/system[1]/m-pump[0]/press-psi</property>
					<property>systems/hydraulics/system[1]/m-pump[1]/press-psi</property>
					<property>systems/hydraulics/system[1]/m-pump[2]/press-psi</property>
					<property>systems/hydraulics/system[1]/m-pump[3]/press-psi</property>
				</sum>
			</expression>
		</input>
		<output>systems/hydraulics/system[1]/TotalPumpPress-psi</output>
	</filter>	
	
	<filter>
		<name>Center System Nose Combined Pressure Demand</name>
		<type>gain</type>
		<gain>1.0</gain>
		<update-interval-secs>0.2</update-interval-secs>
		<input>
			<expression>
				<sum>
					<property>systems/hydraulics/system[1]/Demand/NoseGearSteering-demand-psi</property>
					<property>systems/hydraulics/system[1]/Demand/NoseGearRetraction-demand-psi</property>
				</sum>
			</expression>
		</input>
		<output>systems/hydraulics/system[1]/TotalDemandPress-Nose-psi</output>
	</filter>
	
	<filter>
		<name>Center System C1 Combined Pressure Demand</name>
		<type>gain</type>
		<gain>1.0</gain>
		<update-interval-secs>0.2</update-interval-secs>
		<input>
			<condition>
				<equals>
					<property>systems/hydraulics/system[1]/IslnValve[0]/opened</property>
					<value>1.0</value>
				</equals>
			</condition>
			<expression>
				<sum>
					<property>systems/hydraulics/system[1]/TotalDemandPress-Nose-psi</property>
					<property>systems/hydraulics/system[1]/Demand/ReserveBrakes-demand-psi</property>
				</sum>
			</expression>
		</input>
		<input>systems/hydraulics/system[1]/Demand/ReserveBrakes-demand-psi</input>
		<output>systems/hydraulics/system[1]/TotalDemandPress-C1-psi</output>
	</filter>
	
	<filter>
		<name>Center System C2 Combined Pressure Demand</name>
		<type>gain</type>
		<gain>1.0</gain>
		<update-interval-secs>0.2</update-interval-secs>
		<input>
			<expression>
				<sum>
					<property>systems/hydraulics/system[1]/Demand/Flaps-demand-psi</property>
					<property>systems/hydraulics/system[1]/Demand/MainGearSteering-demand-psi</property>
					<property>systems/hydraulics/system[1]/Demand/LeftGearRetraction-demand-psi</property>
					<property>systems/hydraulics/system[1]/Demand/RightGearRetraction-demand-psi</property>
					<property>systems/hydraulics/system[1]/Demand/Fltctrl-demand-psi</property>
				</sum>
			</expression>
		</input>
		<output>systems/hydraulics/system[1]/TotalDemandPress-C2-psi</output>
	</filter>
	
	<filter>
		<name>Center System Combined Pressure Demand</name>
		<type>gain</type>
		<gain>1.0</gain>
		<update-interval-secs>0.2</update-interval-secs>
		<input>
			<expression>
				<sum>
					<property>systems/hydraulics/system[1]/TotalDemandPress-C1-psi</property>
					<property>systems/hydraulics/system[1]/TotalDemandPress-C2-psi</property>
				</sum>
			</expression>
		</input>
		<output>systems/hydraulics/system[1]/TotalDemandPress-psi</output>
	</filter>
	
	<filter>
		<name>Center System C1C2 Total Pressure Difference</name>
		<type>gain</type>
		<gain>1.0</gain>
		<update-interval-secs>0.2</update-interval-secs>
		<input>
			<expression>
				<sum>
					<property>systems/hydraulics/system[1]/TotalPumpPress-psi</property>
					<property>systems/hydraulics/system[1]/TotalDemandPress-psi</property>
				</sum>
			</expression>
		</input>
		<output>systems/hydraulics/system[1]/PressDiff-psi</output>
	</filter>
	
	<filter>
		<name>Center System C1 Total Pressure Difference</name>
		<type>gain</type>
		<gain>1.0</gain>
		<update-interval-secs>0.2</update-interval-secs>
		<input>
			<expression>
				<sum>
					<property>systems/hydraulics/system[1]/TotalPumpPress-C1-psi</property>
					<property>systems/hydraulics/system[1]/TotalDemandPress-C1-psi</property>
				</sum>
			</expression>
		</input>
		<output>systems/hydraulics/system[1]/PressDiff-C1-psi</output>
	</filter>
	
	<filter>
		<name>Center System C2 Total Pressure Difference</name>
		<type>gain</type>
		<gain>1.0</gain>
		<update-interval-secs>0.2</update-interval-secs>
		<input>
			<expression>
				<sum>
					<property>systems/hydraulics/system[1]/TotalPumpPress-C2-psi</property>
					<property>systems/hydraulics/system[1]/TotalDemandPress-C2-psi</property>
				</sum>
			</expression>
		</input>
		<output>systems/hydraulics/system[1]/PressDiff-C2-psi</output>
	</filter>
	
	<filter>
        <name>Hydraulic C system pressure</name> 
		<!-- If the center isolation valve is closed, C2 pressure is shown on the hyd display-->
		<!-- Pressure is measured at the pump with the highest pressure output-->
        <type>gain</type>
        <update-interval-secs type="double">0.2</update-interval-secs>
        <gain>1.0</gain>
        <input>
			<condition>
				<and>
					<equals>
						<property>systems/hydraulics/system[1]/IslnValve[1]/opened</property>
						<value>1.0</value>
					</equals>
					<greater-than>
						<property>systems/hydraulics/system[1]/PressDiff-psi</property>
						<value>2500</value>
					</greater-than>
				</and>
			</condition>
			<expression>
				<max> <!-- Pressure is determined by pump that delivers highest pressure-->
					<property>systems/hydraulics/system[1]/m-pump[0]/press-psi</property> <!-- C1 Elec pump pressure -->
					<property>systems/hydraulics/system[1]/m-pump[1]/press-psi</property> <!-- C1 Air pump pressure -->
					<property>systems/hydraulics/system[1]/m-pump[2]/press-psi</property> <!-- C2 Elec pump pressure -->
					<property>systems/hydraulics/system[1]/m-pump[3]/press-psi</property> <!-- C2 Air pump pressure -->
					<property>environment/pressure-psi</property> <!-- Outside air pressure (for when no pumps are running) -->
				</max>
			</expression>
        </input>
		<input>
			<condition>
				<equals>
					<property>systems/hydraulics/system[1]/IslnValve[1]/opened</property>
					<value>1.0</value>
				</equals>
			</condition>
			<expression>
				<max>
					<property>systems/hydraulics/system[1]/PressDiff-psi</property>
					<property>environment/pressure-psi</property> <!-- Outside air pressure (for when no pumps are running) -->
				</max>
			</expression>
		</input>
		<input>
			<condition>
				<greater-than>
					<property>systems/hydraulics/system[1]/PressDiff-C2-psi</property>
					<value>2500</value>
				</greater-than>
			</condition>
			<expression>
				<max> <!-- Pressure is determined by pump that delivers highest pressure-->
					<property>systems/hydraulics/system[1]/m-pump[1]/press-psi</property> <!-- C1 Air pump pressure -->
					<property>systems/hydraulics/system[1]/m-pump[2]/press-psi</property> <!-- C2 Elec pump pressure -->
					<property>systems/hydraulics/system[1]/m-pump[3]/press-psi</property> <!-- C2 Air pump pressure -->
					<property>environment/pressure-psi</property> <!-- Outside air pressure (for when no pumps are running) -->
				</max>
			</expression>
		</input>
		<input>systems/hydraulics/system[1]/PressDiff-C2-psi</input>
        <output>systems/hydraulics/system[1]/press-set</output>
    </filter>
	
	<filter>
		<type>noise-spike</type>
		<update-interval-secs>0.2</update-interval-secs>
		<max-rate-of-change>500</max-rate-of-change>
		<input>systems/hydraulics/system[1]/press-set</input>
		<output>systems/hydraulics/system[1]/press-psi</output>
	</filter>
	
	<!-- Hydraulic system pressure warnsystem logic -->
	
	<logic>
		<name>Press Sys L</name>
		<update-interval-secs>0.2</update-interval-secs>
		<input>
			<less-than>
				<property>systems/hydraulics/system[0]/press-psi</property>
				<value>2500</value>
			</less-than>
		</input>
		<output>
			<property>systems/hydraulics/warnsystem/PressSysLeft</property>
		</output>
	</logic>
	
	<logic>
		<name>Press Sys C</name>
		<update-interval-secs>0.2</update-interval-secs>
		<input>
			<less-than>
				<property>systems/hydraulics/system[1]/press-psi</property>
				<value>2500</value>
			</less-than>
		</input>
		<output>
			<property>systems/hydraulics/warnsystem/PressSysCenter</property>
		</output>
	</logic>
	
	<logic>
		<name>Press Sys R</name>
		<update-interval-secs>0.2</update-interval-secs>
		<input>
			<less-than>
				<property>systems/hydraulics/system[2]/press-psi</property>
				<value>2500</value>
			</less-than>
		</input>
		<output>
			<property>systems/hydraulics/warnsystem/PressSysRight</property>
		</output>
	</logic>
	
	

</PropertyList>
